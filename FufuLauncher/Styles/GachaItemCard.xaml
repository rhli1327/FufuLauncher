<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FufuLauncher.Controls"
    xmlns:helpers="using:FufuLauncher.Helpers">

    <DataTemplate x:Key="GachaHistoryUpItemTemplate">
        <Grid Width="44" Height="44">
            <controls:ItemRarityBackground CornerRadius="6" Rarity="{Binding Rank}">
                <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"
                       helpers:ImageFadeInHelper.IsFadeInEnabled="True" />
            </controls:ItemRarityBackground>
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    CornerRadius="0,6,0,6"
                    Padding="5,1"
                    Background="#B3000000">
                <TextBlock Text="{Binding CountText}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="White" />
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="GachaHistoryObtainedItemTemplate">
        <Grid Width="88" Height="112">
            <Grid.RowDefinitions>
                <RowDefinition Height="82" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:ItemRarityBackground CornerRadius="8" Rarity="{Binding Rank}">
                <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"
                       helpers:ImageFadeInHelper.IsFadeInEnabled="True" />
            </controls:ItemRarityBackground>
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    CornerRadius="0,8,0,8"
                    Padding="6,2"
                    Background="#B3000000">
                <TextBlock Text="{Binding CountText}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="White" />
            </Border>
            <TextBlock Grid.Row="1"
                       Margin="2,5,2,0"
                       Text="{Binding Name}"
                       FontSize="10"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>