<?xml version="1.0" encoding="utf-8"?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FufuLauncher.Controls"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml">

    <LinearGradientBrush x:Key="SpeedGraphBrush" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Offset="0" Color="#108caeff" />
        <GradientStop Offset="1" Color="#e08caeff" />
    </LinearGradientBrush>

    <Style TargetType="controls:SpeedGraph">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SpeedGraph">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="States">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <ColorAnimation EnableDependentAnimation="True"
                                                        Storyboard.TargetName="PART_Shape"
                                                        Storyboard.TargetProperty="(Shape.Fill).(LinearGradientBrush.GradientStops)[0].(GradientStop.Color)"
                                                        To="#108caeff" Duration="0:0:0.3" />
                                        <ColorAnimation EnableDependentAnimation="True"
                                                        Storyboard.TargetName="PART_Shape"
                                                        Storyboard.TargetProperty="(Shape.Fill).(LinearGradientBrush.GradientStops)[1].(GradientStop.Color)"
                                                        To="#e08caeff" Duration="0:0:0.3" />
                                        <ColorAnimation EnableDependentAnimation="True"
                                                        Storyboard.TargetName="PART_SpeedLine"
                                                        Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)"
                                                        To="#CC8CAEFF" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="PART_AverageSpeedLine"
                                                         Storyboard.TargetProperty="Opacity" To="0.3"
                                                         Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="PART_AverageSpeedText"
                                                         Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" />
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Pause">
                                    <Storyboard>
                                        <ColorAnimation EnableDependentAnimation="True"
                                                        Storyboard.TargetName="PART_Shape"
                                                        Storyboard.TargetProperty="(Shape.Fill).(LinearGradientBrush.GradientStops)[0].(GradientStop.Color)"
                                                        To="#10e0e020" Duration="0:0:0.3" />
                                        <ColorAnimation EnableDependentAnimation="True"
                                                        Storyboard.TargetName="PART_Shape"
                                                        Storyboard.TargetProperty="(Shape.Fill).(LinearGradientBrush.GradientStops)[1].(GradientStop.Color)"
                                                        To="#e0ffff00" Duration="0:0:0.3" />
                                        <ColorAnimation EnableDependentAnimation="True"
                                                        Storyboard.TargetName="PART_SpeedLine"
                                                        Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)"
                                                        To="#CCFFE000" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="PART_AverageSpeedLine"
                                                         Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="PART_AverageSpeedText"
                                                         Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Error">
                                    <Storyboard>
                                        <ColorAnimation EnableDependentAnimation="True"
                                                        Storyboard.TargetName="PART_Shape"
                                                        Storyboard.TargetProperty="(Shape.Fill).(LinearGradientBrush.GradientStops)[0].(GradientStop.Color)"
                                                        To="#10b01010" Duration="0:0:0.3" />
                                        <ColorAnimation EnableDependentAnimation="True"
                                                        Storyboard.TargetName="PART_Shape"
                                                        Storyboard.TargetProperty="(Shape.Fill).(LinearGradientBrush.GradientStops)[1].(GradientStop.Color)"
                                                        To="#e0ff1010" Duration="0:0:0.3" />
                                        <ColorAnimation EnableDependentAnimation="True"
                                                        Storyboard.TargetName="PART_SpeedLine"
                                                        Storyboard.TargetProperty="(Shape.Stroke).(SolidColorBrush.Color)"
                                                        To="#CCFF5050" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="PART_AverageSpeedLine"
                                                         Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="PART_AverageSpeedText"
                                                         Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid x:Name="PART_GraphGrid" Visibility="Collapsed">
                            <win2d:CanvasControl x:Name="PART_Canvas" HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch" ClearColor="Transparent" />

                            <Grid x:Name="PART_ShapeHost" RenderTransformOrigin="0 1.0">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="PART_GraphScale" />
                                </Grid.RenderTransform>
                                <Path x:Name="PART_Shape" Fill="{StaticResource SpeedGraphBrush}" />
                                <Path x:Name="PART_SpeedLine" Stroke="#CC8CAEFF" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Grid>

                            <Grid x:Name="PART_HostGrid">
                                <Line x:Name="PART_AverageSpeedLine" Opacity="0.3"
                                      Stroke="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                      Visibility="{TemplateBinding SpeedLineVisibility}" X1="0" X2="10000"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <TextBlock x:Name="PART_AverageSpeedText" Margin="0,-20,10,0"
                                           HorizontalAlignment="Right" Opacity="0.8" Text="{TemplateBinding SpeedText}"
                                           Visibility="{TemplateBinding SpeedTextVisibility}" />
                            </Grid>
                        </Grid>

                        <TextBlock x:Name="PART_SpeedGraphNoDataAvailableText" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="30" Opacity="0.5"
                                   Text="{TemplateBinding NoDataText}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>