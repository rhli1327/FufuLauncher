<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="FufuLauncher.Views.OverseaOAuthWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:FufuLauncher.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="{helpers:Loc Key=LoginQR_ThirdPartyLoginTitle}">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <TextBlock
                Text="{helpers:Loc Key=LoginQR_ThirdPartyLoginTitle}"
                VerticalAlignment="Center"
                Margin="16,0,0,0"
                FontSize="14"
                Opacity="0.8" />
        </Grid>

        <WebView2
            x:Name="OAuthWebView"
            Grid.Row="1"
            Margin="12,0,12,12"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />
    </Grid>
</Window>