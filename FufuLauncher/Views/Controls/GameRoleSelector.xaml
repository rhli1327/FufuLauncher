<UserControl
    x:Class="FufuLauncher.Views.GameRoleSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:FufuLauncher.Helpers">
    <StackPanel Spacing="4">
        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="RoleBox" HorizontalAlignment="Stretch" MaxWidth="420"
                      PlaceholderText="{helpers:Loc Key=GameRole_Select}"
                      ToolTipService.ToolTip="{helpers:Loc Key=GameRole_Hint}"
                      SelectionChanged="RoleBox_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Padding="8" Click="Refresh_Click"
                    ToolTipService.ToolTip="{helpers:Loc Key=GameRole_Refresh}">
                <FontIcon Glyph="&#xE72C;" FontSize="12" />
            </Button>
        </Grid>
        <TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap"
                   Visibility="Collapsed" />
    </StackPanel>
</UserControl>